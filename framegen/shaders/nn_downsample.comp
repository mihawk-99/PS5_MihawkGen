#version 450
// PS5_FrameGen - neural method, step 1: a frame reduced to the network's working
// size by averaging a grid of bilinear taps across each output pixel's footprint
// (a box filter, as the training scenes' area averaging).
//
// Copyright (C) 2026 Mihawk
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 8, local_size_y = 8) in;
layout(constant_id = 0) const int TAPS_X = 4;   // taps per footprint, per axis (a bilinear tap averages two texels)
layout(constant_id = 1) const int TAPS_Y = 4;
layout(binding = 0) uniform sampler2D frame;
layout(binding = 1, rgba16f) uniform writeonly image2D result;
layout(push_constant) uniform Params {
	ivec2 size;  // the working size
} params;

void main()
{
	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, params.size))) {
		return;
	}
	vec3 sum = vec3(0.0);
	for (int j = 0; j < TAPS_Y; j++) {
		for (int i = 0; i < TAPS_X; i++) {
			const vec2 at = (vec2(p) + (vec2(i, j) + 0.5) / vec2(TAPS_X, TAPS_Y)) / vec2(params.size);
			sum += textureLod(frame, at, 0.0).rgb;
		}
	}
	imageStore(result, p, vec4(sum / float(TAPS_X * TAPS_Y), 1.0));
}
