#version 450
// PS5_FrameGen - method "mvsplat", pass 8: the output. A pixel a reading was trusted for keeps it; the others take the
// pyramid's fill.
//
// Copyright (C) 2026 Mihawk
// SPDX-License-Identifier: GPL-3.0-or-later
#extension GL_GOOGLE_include_directive : require
#include "splat_common.glsl"
layout(binding = 0) uniform sampler2D result;
layout(binding = 1) uniform sampler2D coarserFilled;
layout(binding = 5, rgba8) uniform writeonly image2D outputImage;

void main()
{
	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, pc.size))) {
		return;
	}
	const vec4 r = texelFetch(result, p, 0);
	if (r.a > 0.5) {
		imageStore(outputImage, p, vec4(r.rgb, 1.0));
		return;
	}
	const ivec2 cs = textureSize(coarserFilled, 0);
	const vec2 s = (vec2(p) + 0.5) * 0.5 - 0.5;
	const ivec2 i0 = ivec2(floor(s));
	const vec2 f = s - vec2(i0);
	vec4 acc = vec4(0.0);
	for (int o = 0; o < 4; o++) {
		const ivec2 q = clamp(i0 + ivec2(o & 1, o >> 1), ivec2(0), cs - 1);
		const float w = ((o & 1) != 0 ? f.x : 1.0 - f.x) * ((o >> 1) != 0 ? f.y : 1.0 - f.y);
		const vec4 v = texelFetch(coarserFilled, q, 0);
		acc += vec4(v.rgb * v.a, v.a) * w;
	}
	imageStore(outputImage, p, vec4(acc.a > 1e-4 ? acc.rgb / acc.a : vec3(0.0), 1.0));
}
