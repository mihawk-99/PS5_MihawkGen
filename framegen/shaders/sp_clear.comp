#extension GL_GOOGLE_include_directive : require
#include "splat_common.glsl"
layout(binding = 6, r32ui) uniform writeonly uimage2D winning;

void main()
{
	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, pc.size))) {
		return;
	}
	imageStore(winning, p, uvec4(kNoDepth));
}
